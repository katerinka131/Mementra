<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ФОН ВСЕЙ СТРАНИЦЫ -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/onboarding_bg" />

    <!-- Основной контент -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Заголовок Mementro вверху -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mementro"
            android:textSize="36sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="60dp"
            android:layout_marginBottom="40dp"
            android:textColor="@color/white"
            android:fontFamily="@font/comforta" />

        <!-- Баннер с мотивационными карточками -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/motivationViewPager"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <!-- Индикатор точек -->
        <LinearLayout
            android:id="@+id/dotsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center" />

        <!-- Пустое пространство -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Нижняя панель ТОЛЬКО С КНОПКОЙ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#20000000">

            <!-- Кнопка Начать на всю ширину -->
            <Button
                android:id="@+id/startButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Начать"
                android:textSize="18sp"
                android:padding="16dp"
                android:textColor="@color/white"
                android:fontFamily="@font/comforta"
                app:backgroundTint="@color/purple_500" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>