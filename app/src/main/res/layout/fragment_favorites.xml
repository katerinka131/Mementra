<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Заголовок -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="❤️ Избранные воспоминания"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Placeholder когда нет избранных -->
    <LinearLayout
        android:id="@+id/favoritesPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/favoritesPlaceholderText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Пока нет избранных воспоминаний"
            android:textSize="16sp"
            android:gravity="center"
            android:lineSpacingExtra="8dp" />

    </LinearLayout>

    <!-- RecyclerView для списка избранных -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/favoritesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</LinearLayout>